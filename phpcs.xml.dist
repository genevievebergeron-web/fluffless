<?xml version="1.0"?>
<ruleset name="Fluffless WP">
	<file>packages/fluffless-suite</file>
	<file>packages/fluffless-seo</file>
	<file>packages/fluffless-consent</file>
	<file>packages/fluffless</file>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.2-"/>
	<config name="minimum_wp_version" value="6.8"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="fluffless-suite"/>
				<element value="fluffless-seo"/>
				<element value="fluffless-consent"/>
				<element value="fluffless"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="fluffless"/>
			</property>
		</properties>
	</rule>
	<!-- Classes en PSR-4 dans src/ : nommage de fichiers WordPress non applicable. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>packages/fluffless-suite/src/*</exclude-pattern>
		<exclude-pattern>packages/fluffless-seo/src/*</exclude-pattern>
		<exclude-pattern>packages/fluffless-consent/src/*</exclude-pattern>
		<!-- Nom imposé par @wordpress/scripts pour les dépendances d'un bloc. -->
		<exclude-pattern>packages/fluffless-seo/blocks/*/index.asset.php</exclude-pattern>
	</rule>
</ruleset>
