{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fluffless/barre",
	"version": "0.2.1",
	"title": "Bar",
	"category": "design",
	"icon": "minus",
	"description": "One bar of a Progress bars block: a label and a value from 0 to 100.",
	"keywords": [
		"bar",
		"progress",
		"barre"
	],
	"textdomain": "fluffless-suite",
	"parent": [
		"fluffless/barres"
	],
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"value": {
			"type": "integer",
			"default": 60
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"anchor": false,
		"customClassName": false
	},
	"editorScript": "file:./index.js"
}
