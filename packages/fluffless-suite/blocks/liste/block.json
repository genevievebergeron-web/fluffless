{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fluffless/liste",
	"version": "0.2.1",
	"title": "Heading, text and list",
	"category": "design",
	"icon": "editor-ul",
	"description": "A heading, a short text and a list with bullets, check marks or numbers, on one or two columns, with or without a button. The content stays in regular blocks.",
	"keywords": [ "list", "bullets", "checklist", "steps", "liste" ],
	"textdomain": "fluffless-suite",
	"attributes": {
		"anchor": { "type": "string" },
		"marker": { "type": "string", "enum": [ "bullet", "check", "number" ], "default": "bullet" },
		"columns": { "type": "number", "enum": [ 1, 2 ], "default": 1 }
	},
	"supports": {
		"html": false,
		"reusable": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"customClassName": true
	},
	"editorScript": "file:./index.js",
	"style": [ "fluffless-sections", "file:./style.css" ]
}
