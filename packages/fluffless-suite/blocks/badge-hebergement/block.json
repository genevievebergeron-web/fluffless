{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fluffless/badge-hebergement",
	"version": "0.2.1",
	"title": "Verified hosting badge",
	"example": {},
	"category": "widgets",
