{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fluffless/popup",
	"version": "0.2.1",
	"title": "Pop-up",
	"example": {"attributes": {"label": "Open"}},
	"category": "design",
	"icon": "welcome-view-site",
	"description": "A window that opens only when a visitor clicks its button, or a dismissible announcement bar. Native HTML, no JavaScript, never opens on its own.",
	"keywords": [ "popup", "modal", "dialog", "announcement", "banner", "fenêtre" ],
	"textdomain": "fluffless-suite",
	"attributes": {
		"anchor": { "type": "string" },
		"mode": { "type": "string", "enum": [ "popup", "banner" ], "default": "popup" },
		"label": { "type": "string", "default": "" },
		"closeLabel": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"reusable": false,
		"anchor": true,
		"customClassName": true
	},
	"editorScript": "file:./index.js"
}
