#: src/Modules/Reviewer.php:241
msgid "Reviewer"
msgstr "Réviseur"

#: src/Modules/Reviewer.php:145
msgid "A Reviewer role that can leave notes on the pages it is assigned to, and change nothing else: no other capability, no route outside a strict allow list."
msgstr "Un rôle Réviseur qui peut laisser des notes sur les pages confiées, sans rien modifier d’autre : aucun autre droit, aucun accès hors d’une courte liste autorisée."

#: src/Modules/Reviewer.php:283
msgid "Reviewers assigned to this content"
msgstr "Réviseurs confiés à ce contenu"

#: src/Modules/Reviewer.php:284
msgid "User IDs allowed to leave notes here as a Reviewer."
msgstr "Identifiants des comptes autorisés à laisser des notes ici, à titre de réviseur."

#: src/Modules/Reviewer.php:736
