#, php-format
msgid "No caching instruction for %s: browsers may download it on every visit."
msgstr "Aucune consigne de cache pour %s : les navigateurs peuvent le télécharger à chaque visite."

#: src/Modules/Audit.php:944
msgid "Impossible to check: no file of this type was found on the home page."
msgstr "Impossible à vérifier : aucun fichier de ce type n'a été trouvé sur l'accueil."

