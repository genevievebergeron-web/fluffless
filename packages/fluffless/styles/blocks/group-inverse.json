{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "Inverted",
	"slug": "inverse",
	"blockTypes": [ "core/group", "core/column", "core/cover" ],
	"styles": {
		"color": {
			"background": "var:preset|color|contrast",
			"text": "var:preset|color|base"
		},
		"elements": {
			"link": { "color": { "text": "var:preset|color|base" } },
			"heading": { "color": { "text": "var:preset|color|base" } },
			"button": {
				"color": { "background": "var:preset|color|base", "text": "var:preset|color|contrast" },
				"border": { "color": "var:preset|color|base" }
			}
		}
	}
}
