{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "Diagonal",
	"slug": "diagonale",
	"blockTypes": [ "core/group", "core/column", "core/image" ],
	"styles": {
		"color": { "background": "var:preset|color|surface" },
		"border": {
			"radius": {
				"topLeft": "var:custom|radius|large",
				"topRight": "var:custom|radius|small",
				"bottomRight": "var:custom|radius|large",
				"bottomLeft": "var:custom|radius|small"
			}
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|50",
				"bottom": "var:preset|spacing|50",
				"left": "var:preset|spacing|50",
				"right": "var:preset|spacing|50"
			}
		}
	}
}
