{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "Card",
	"slug": "carte",
	"blockTypes": [ "core/group", "core/column" ],
	"styles": {
		"color": { "background": "var:preset|color|surface" },
		"border": { "radius": "var:custom|radius|soft", "width": "1px", "style": "solid", "color": "var:preset|color|divider" },
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|50",
				"bottom": "var:preset|spacing|50",
				"left": "var:preset|spacing|50",
				"right": "var:preset|spacing|50"
			}
		}
	}
}
