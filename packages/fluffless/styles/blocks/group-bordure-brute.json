{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "Raw border",
	"slug": "bordure-brute",
	"blockTypes": [ "core/group", "core/column", "core/details" ],
	"styles": {
		"color": { "background": "var:preset|color|base" },
		"border": { "radius": "var:custom|radius|none", "width": "3px", "style": "solid", "color": "var:preset|color|contrast" },
		"shadow": "var:preset|shadow|hard",
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|50",
				"bottom": "var:preset|spacing|50",
				"left": "var:preset|spacing|50",
				"right": "var:preset|spacing|50"
			}
		}
	}
}
