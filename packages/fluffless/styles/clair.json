{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "Light",
	"description": "Cool near-white ground, ink-blue text, teal accent: the airiest palette, for sites that want to feel light.",
	"settings": {
		"color": {
			"duotone": [
				{ "slug": "contraste", "name": "Contrast on base", "colors": [ "#14202b", "#f6f8f9" ] },
				{ "slug": "accent", "name": "Accent on base", "colors": [ "#0b6b7d", "#f6f8f9" ] }
			],
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#f6f8f9" },
				{ "slug": "surface", "name": "Surface", "color": "#e6ecef" },
				{ "slug": "contrast", "name": "Contrast", "color": "#14202b" },
				{ "slug": "muted", "name": "Secondary text", "color": "#4a5a68" },
				{ "slug": "divider", "name": "Line", "color": "#6f8290" },
				{ "slug": "accent", "name": "Accent", "color": "#0b6b7d" },
				{ "slug": "on-accent", "name": "Text on accent", "color": "#f6f8f9" },
				{ "slug": "accent-2", "name": "Second accent", "color": "#7b3f99" },
				{ "slug": "alert", "name": "Alert", "color": "#b3261e" }
			]
		}
	},
	"styles": {
		"elements": {
			"heading": { "typography": { "fontWeight": "500", "letterSpacing": "-0.02em" } },
			"button": { "border": { "radius": "var:custom|radius|small" } }
		}
	}
}
