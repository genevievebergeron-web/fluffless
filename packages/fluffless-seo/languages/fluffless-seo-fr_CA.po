msgid "Local business details"
msgstr "Renseignements sur l’entreprise locale"

#: src/Admin/SettingsScreen.php:194
msgid "Used when this site represents a local business."
msgstr "Utilisés quand ce site représente une entreprise locale."

#: src/Admin/SettingsScreen.php:205
msgid "Breadcrumbs"
msgstr "Fil d’Ariane"

