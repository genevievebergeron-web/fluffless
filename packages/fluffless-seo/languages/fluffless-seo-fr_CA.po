#: src/Admin/SettingsScreen.php:235
msgid "IndexNow"
msgstr "IndexNow"

#: src/Admin/SettingsScreen.php:236
msgid "Tells Bing, Yandex and others when a page is published. Sends one request to api.indexnow.org per publication, without waiting for the answer. Allow this host in the Fluffless Suite outgoing requests list if it is filtered."
msgstr "Avertit Bing, Yandex et d’autres quand une page est publiée. Envoie une requête à api.indexnow.org par publication, sans attendre la réponse. Autorise ce domaine dans la liste des requêtes sortantes de Fluffless Suite si elle est filtrée."

#: src/Admin/SettingsScreen.php:241
msgid "Webmaster tools verification"
msgstr "Validation des outils pour webmestres"

#: src/Admin/SettingsScreen.php:242
msgid "Written on the home page only."
msgstr "Écrite sur la page d’accueil seulement."

#: src/Admin/SettingsScreen.php:254
msgid "Moved pages"
msgstr "Pages déplacées"

#: src/Admin/SettingsScreen.php:255
msgid "Rules and the not found log are managed in the Redirects tab."
msgstr "Les règles et le journal des pages introuvables se gèrent dans l’onglet Redirections."

#: src/Admin/SettingsScreen.php:259
msgid "Redirects"
msgstr "Redirections"

#: src/Admin/SettingsScreen.php:260
msgid "301, 302, 307 and 410, with optional regular expressions."
msgstr "301, 302, 307 et 410, avec expressions régulières au besoin."

