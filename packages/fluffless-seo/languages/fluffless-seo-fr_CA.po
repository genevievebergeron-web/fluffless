msgid "Crawlers"
msgstr "Robots d’indexation"

#: src/Admin/SettingsScreen.php:213
msgid "Files and signals read by search engines and other robots."
msgstr "Fichiers et signaux lus par les moteurs de recherche et les autres robots."

#: src/Admin/SettingsScreen.php:217
msgid "Sitemap"
msgstr "Plan du site"

#: src/Admin/SettingsScreen.php:218
msgid "Adjusts the sitemap built into WordPress. Pages set to noindex are left out."
msgstr "Ajuste le plan du site intégré à WordPress. Les pages réglées en noindex en sont exclues."

#: src/Admin/SettingsScreen.php:223
msgid "Custom robots.txt"
msgstr "robots.txt personnalisé"

