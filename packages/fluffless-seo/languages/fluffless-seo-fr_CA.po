#. Plugin Name of the plugin
#: fluffless-seo.php
#: src/Admin/SettingsScreen.php:87
#: src/Admin/SettingsScreen.php:119
msgid "Fluffless SEO"
msgstr "Fluffless SEO"

#. Plugin URI of the plugin
#: fluffless-seo.php
msgid "https://fluffless.dev"
msgstr "https://fluffless.dev"

#. Description of the plugin
#: fluffless-seo.php
msgid "Complete, server-side SEO for any theme: titles, social tags, structured data, breadcrumbs, redirects and sitemaps. No JavaScript for visitors."
msgstr "Référencement complet, côté serveur, pour tout thème : titres, balises de partage, données structurées, fil d’Ariane, redirections et plans du site. Aucun JavaScript pour les gens qui visitent le site."

#. Author of the plugin
#: fluffless-seo.php
msgid "Geneviève Bergeron"
msgstr "Geneviève Bergeron"

#. Author URI of the plugin
#: fluffless-seo.php
msgid "https://genevievebergeron.ca"
msgstr "https://genevievebergeron.ca"

#: src/Admin/SettingsScreen.php:119
msgid "Titles, sharing, structured data and redirects, written on the server. Your visitors download no script for it."
msgstr "Titres, partage, données structurées et redirections, écrits par le serveur. Les gens qui visitent ton site ne téléchargent aucun script pour ça."

