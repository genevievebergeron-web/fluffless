# Modèle des variables d'environnement du serveur Fluffless. Aucune valeur ici :
# les vraies vivent dans les variables d'env canner et dans le coffre Proton Drive.

# Fournie par canner (base Postgres du projet).
DATABASE_URL=
# Origine publique utilisée pour construire les liens de téléchargement signés.
PUBLIC_URL=
# Port d'écoute; canner l'injecte.
PORT=
# Clé privée ed25519, PKCS8 DER encodée en base64 (une ligne).
SIGNING_PRIVATE_KEY=
# Jeton Bearer des routes /v1/admin (32 caractères au moins).
ADMIN_TOKEN=
# Secret HMAC des liens de téléchargement de 15 minutes (32 caractères au moins).
URL_SECRET=
# Poivre HMAC des clés de licence et des sites (32 caractères au moins). Ne jamais le changer sans migration.
HASH_PEPPER=
# 1 (défaut) : l'IP client est la dernière entrée de X-Forwarded-For (mandataire canner).
TRUST_PROXY=
# Jeton du serveur de fluffless.dev pour relayer l'IP d'une cliente sur /v1/packs (optionnel,
# 32 caractères au moins). Sans lui, la limite par IP vise l'appelant direct.
PACKS_PROXY_TOKEN=
# Vente de packs par Stripe (optionnel, tout ou rien). Sans elles, /v1/packs/checkout et le
# webhook répondent 503. Clé secrète ou restreinte (sk_… ou rk_…), secret de signature du
# point de terminaison https://api.fluffless.dev/v1/webhooks/stripe (whsec_…), et pages de
# retour de fluffless.dev après paiement et après abandon.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# Optionnelle : version d'API épinglée, la même que celle du point de terminaison.
STRIPE_API_VERSION=
# 1 : vente hors Canada par Managed Payments (Stripe revendeur). Vide ou 0 par défaut; ne pas
# l'allumer avant la confirmation écrite de Stripe et l'avis comptable (README, Stripe).
STRIPE_MANAGED_PAYMENTS=
# Signalements et liens de packs par Proton Mail (optionnel; sans eux, rien n'est envoyé
# et /v1/packs/claim répond 503).
PROTON_SMTP_USER=
PROTON_SMTP_TOKEN=
NOTIFY_TO=
# Alertes (paiement échoué, achat réglé après remboursement) : adresse du webhook, vide par défaut.
# https seulement (http vers 127.0.0.1, localhost ou [::1]). Sans elle, le courriel Proton sert.
ALERT_WEBHOOK_URL=
